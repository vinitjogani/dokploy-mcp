# Where connectors reach this server (an origin: no path, no trailing slash).
PUBLIC_BASE_URL=https://mcp.example.com
# The only login. Re-applied on every boot; changing it revokes every connector's tokens.
# At least 12 characters and not a common password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Dokploy > Settings > Profile > API keys, as the owner/admin (so domain collision checks see every
# domain). Leave rate limiting off: if enabled, the default is 10 requests per day.
DOKPLOY_API_KEY=
# Default reaches the panel over dokploy-network. Alternatives: http://host.docker.internal:3000
# (add extra_hosts: ["host.docker.internal:host-gateway"]) or the panel's public URL.
DOKPLOY_URL=http://dokploy:3000
# Hosts add_domain may use; "blog" is expanded to blog.<first entry>. Defaults to the parent
# domain of PUBLIC_BASE_URL.
DOMAINS=example.com
# More compose services the MCP can read but never change (id, name, appName, or GitHub repo).
# Its own service is always protected.
PROTECTED_SERVICES=
# Hosts that can never be routed to a service, e.g. the Dokploy panel if it has a domain
# (it is also looked up automatically). This server's own host is always protected.
PROTECTED_HOSTS=
# Exact redirect URIs connectors may register (http://localhost:<port>/... is always allowed).
OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
